# ==========================================
# Sentinel V7 (Project Salsette) Environment Configuration
# ==========================================

# Core API & Telemetry Host
HOST=0.0.0.0
PORT=8000
SENTINEL_CERTIFY_URL=http://localhost:8000

# HashiCorp Vault Security Secrets
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=your_vault_token_here
SENTINEL_VAULT_PATH=sentinel/production

# Cryptographic Keys (HMAC SHA-256 & AES-256)
V7_SECURITY_SECRET=your_32_byte_hmac_secret_key_here
V7_ENCRYPTION_KEY=your_32_byte_aes_gcm_encryption_key_here

# Redis Cache & Anti-Replay Store
REDIS_HOST=localhost
REDIS_PORT=6379
SENTINEL_REDIS_OPTIONAL=true

# Geographic Reference Coordinates (Mumbai Metropolitan)
SENTINEL_METEO_LAT=19.0760
SENTINEL_METEO_LON=72.8777
SENTINEL_MODEL_TRUST=neural

# External AI & Astronomy APIs (Optional)
GEMINI_API_KEY=your_google_gemini_api_key_here
NASA_API_KEY=DEMO_KEY
